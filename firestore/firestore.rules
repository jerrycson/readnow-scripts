rules_version = '2';
// 리드나우 Firestore 보안 규칙 — 원본(wguard2 11/18 · 리드 결정 F57)
//  · 11/18 배포돼 있던 규칙(ruleset eea9d7b5)을 그대로 옮기고 🔒 상품 잠금(prd_locks) 칸만 더함
//  · 직원 계정 목록은 공개 저장소에 두지 않음 — 아래 자리 표시(STAFF 목록 한 줄)를 배포 도구(src/tools/rules-deploy.js)가
//    지금 배포된 규칙의 목록 그대로 채움(목록을 바꾸는 일은 Firebase 콘솔 · 이 파일로는 안 바뀜)
//  · 클라우드(관리자 SDK)는 규칙을 거치지 않음 — 웹앱·수집기·가격 감시기(로그인한 직원)만 이 규칙을 받음
//  · 바꾸면 에뮬레이터 시험(firestore/rules.test.js)을 통과한 뒤에만 배포
service cloud.firestore {
  match /databases/{database}/documents {

    // 리드나우 시스템을 쓸 수 있는 계정 (구글 로그인·이메일 로그인 모두)
    function staff() {
      return request.auth != null
        && request.auth.token.email in [
          '__STAFF_EMAILS__'
        ];
    }
    function prdStaff() { return staff(); }

    // 🔒 상품 잠금 — 정범님 11/17 · reports/PLOCK_1117.md 「Firestore 규칙」
    //  · 문서 지우기 금지(풀기는 on=false로) · 정해진 칸만 · 기록(hist)은 늘기만(줄이거나 비울 수 없음)
    //  · (11/18 lockcond1 · 정범님 I-1118-1417-15.4) 세 갈래 잠금 칸 더함 — mode(새로·완전·조건) · cond(조건) · from·out(잠근 자리·그 자리에서 뺌) · hit(조건이 막은 횟수) · day(오늘 바꾼 횟수·금액)
    function plockKeys() {
      return ['on', 'why', 'grp', 'by', 'at', 'lid', 'usedCode', 'sku', 'title', 'img', 'plat', 'vals', 'hist', 'lockedAt', 'unlockedAt', 'mode', 'cond', 'from', 'out', 'hit', 'day'];
    }
    match /prd_locks/{k} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.keys().hasOnly(plockKeys())
        && request.resource.data.get('hist', []) is list;
      allow update: if staff()
        && request.resource.data.keys().hasOnly(plockKeys())
        && request.resource.data.get('hist', []) is list
        && request.resource.data.get('hist', []).size() >= resource.data.get('hist', []).size();
      allow delete: if false;
    }

    // 🎛 관제소 날마다 요약(kpib1 11/19 · 정범님 I-1119-2051-30 · reports/CTRLKPI1_1119.md) — 클라우드만 씀(관리자 SDK는 규칙을 거치지 않음)
    //  · 웹앱(직원)은 읽기만 · 쓰기·지우기 막힘(지난 날 기록을 웹앱이 고치거나 지우지 못하게)
    match /ctl_kpi_m/{k} {
      allow read: if staff();
      allow write: if false;
    }
    match /ctl_kpi_days/{k} {
      allow read: if staff();
      allow write: if false;
    }

    // 나머지 모두 — 예전 그대로(직원 읽기·쓰기) · 쓰기만 prd_locks·관제소 요약을 뺌(규칙은 '또는'으로 묶이므로)
    match /{document=**} {
      allow read: if staff();
      allow write: if staff() && !(request.path[3] in ['prd_locks', 'ctl_kpi_m', 'ctl_kpi_days']);
    }
  }
}
